<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefWidth="200" styleClass="card" prefHeight="350" xmlns:fx="http://javafx.com/fxml/1">
    <VBox alignment="CENTER" spacing="10" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">
        <Label fx:id="day" textFill="white" text="Saikat" />
        <Label fx:id="temp" textFill="antiquewhite" text="Temp" styleClass="temp" />
        <Label fx:id="cloud" textFill="antiquewhite" text="Cloud" />
    </VBox>
</AnchorPane>